# Service listens on 127.0.0.1 only by default. Set BIND_ADDRESS=0.0.0.0
# only when API_KEY is set and network access is intended.
BIND_ADDRESS=127.0.0.1
PORT=8000

# Leave empty for local-only use. Set a long random value before exposing the API
# through a trusted private network or reverse proxy.
API_KEY=

# Replace with your organization resolver if policy requires it.
DNS_SERVER=1.1.1.1
DNS_FALLBACK_SERVER=8.8.8.8

MAX_UPLOAD_BYTES=209715200
MAX_EXPANDED_BYTES=1073741824
MAX_ARCHIVE_ENTRIES=20000
MAX_FINDINGS=10000
SCAN_TIMEOUT_SECONDS=900
RETENTION_DAYS=30
# Expired jobs are removed at startup and then every PRUNE_INTERVAL_SECONDS.
PRUNE_INTERVAL_SECONDS=3600
MEMORY_LIMIT=6g
CPU_LIMIT=2.0

# Throughput on one node. The defaults run one scan at a time and its scanners
# one after another. Raise MEMORY_LIMIT and CPU_LIMIT along with these.
SCAN_CONCURRENCY=1
SCANNER_PARALLELISM=1
# Cap on scanner processes across all scans. Empty means
# SCAN_CONCURRENCY x SCANNER_PARALLELISM.
MAX_SCANNER_PROCESSES=
# Per-tool caps as name=limit overrides of the default trivy=1,joern=1.
# 0 removes a cap, for example: SCANNER_PROCESS_LIMITS=trivy=2,semgrep=1
SCANNER_PROCESS_LIMITS=

# Scanner versions are pinned by default for repeatable image builds.
SEMGREP_VERSION=1.179.0
GITLEAKS_VERSION=8.30.1
TRIVY_VERSION=0.74.0
OSV_SCANNER_VERSION=2.6.0
JOERN_VERSION=4.0.631

# Set to 1 to install Joern. This adds a very large (about 1.67 GB) CLI archive
# and a JDK to the image. Rebuild the image after changing this value.
INSTALL_JOERN=0
